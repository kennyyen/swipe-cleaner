{
  "expo": {
    "name": "Swipe Cleaner",
    "slug": "swipe-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Swipe Cleaner to access your photos to help you clean up your library.",
          "savePhotosPermission": "Allow Swipe Cleaner to move photos into albums.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video"
    ],
    "ios": {
      "bundleIdentifier": "com.kennyyen.swipecleaner",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kennyyen.swipecleaner",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
